# Segredo usado para assinar os tokens JWT do backend — troque em produção
JWT_SECRET=troque-este-valor-por-um-segredo-forte

# Origens permitidas a chamar a API (separadas por vírgula)
CORS_ORIGIN=http://localhost:8080,http://localhost:8081

# URL da API que o frontend e o painel vão chamar do navegador
FRONTEND_API_URL=http://localhost:3333/api
